# LoveyNest — contoh konfigurasi. Salin menjadi .env lalu isi nilainya.
# JANGAN commit file .env. Jangan isi rahasia asli di file ini.

APP_NAME="LoveyNest"
APP_ENV=local
APP_KEY=
# true hanya untuk pengembangan lokal. Wajib false bila diakses orang lain.
APP_DEBUG=true
# Ganti dengan alamat yang dipakai untuk membuka aplikasi, mis. https://192.168.1.10
APP_URL=http://localhost:8000
APP_VERSION=0.1.0

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
# Zona waktu default untuk pengguna baru. Timestamp di database selalu UTC.
USANDUS_DEFAULT_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP memakai MariaDB. Default XAMPP: user root tanpa password.
# Disarankan membuat user khusus (lihat docs/instalasi-xampp.md).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usandus
DB_USERNAME=root
DB_PASSWORD=

# Enkripsi end-to-end (isi chat, foto, jurnal, dll dikunci di HP). Butuh HTTPS. Isi false untuk mematikan.
E2E_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Otomatis aman bila APP_URL https. Isi true/false untuk memaksa.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# Chat langsung: aktifkan dengan "php artisan usandus:realtime" (butuh "php artisan reverb:start")
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Push dan pengingat dikirim lewat queue. Jalankan: php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database

# Lupa password hanya aktif bila SMTP dikonfigurasi (MAIL_MAILER=smtp).
# Dengan "log", fitur lupa password disembunyikan agar token reset tidak tertulis ke log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@usandus.local"
MAIL_FROM_NAME="${APP_NAME}"

# Kuis dengan AI (opsional). Pilih salah satu; kunci gratis.
# Groq: https://console.groq.com/keys   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web Push (VAPID). Buat dengan: php artisan usandus:vapid
VAPID_SUBJECT="mailto:admin@usandus.local"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opsional. Daftar host push service yang diterima, dipisah koma (bawaan: Chrome/Edge/Firefox/Safari).
# PUSH_ALLOWED_HOSTS=

# Backup database. Di Windows/XAMPP biasanya C:\xampp\mysql\bin\mysqldump.exe
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_MYSQL_PATH=mysql
BACKUP_KEEP=14

VITE_APP_NAME="${APP_NAME}"

# Reverb (diisi otomatis oleh usandus:realtime)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Hanya jika situs di belakang proxy (misalnya Cloudflare): isi * agar IP pengunjung terbaca benar.
TRUSTED_PROXIES=
